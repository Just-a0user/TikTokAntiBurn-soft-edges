<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="#241F1F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/Additional_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/fast_setting_bg"
            android:padding="12dp"
            tools:layout_editor_absoluteX="16dp"
            tools:layout_editor_absoluteY="250dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/EnableLogging"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/Settings_ADD_LogsTitle"
                android:textColor="@color/SeekBackgroundFilled"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:thumbTint="@color/SeekBackgroundFilled"
                app:trackDecorationTint="@color/SeekBackgroundFilled"
                app:trackTint="@color/MID" />

            <TextView
                android:id="@+id/textView14"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:alpha="0.75"
                android:paddingBottom="6dp"
                android:text="@string/Settings_ADD_LogsDesc"
                android:textColor="@color/SeekBackgroundFilled"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/EnableLogging" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/Additional_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:background="@drawable/fast_setting_bg"
            android:padding="12dp"
            tools:layout_editor_absoluteX="16dp"
            tools:layout_editor_absoluteY="250dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/Compatibility_MODE"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/OptimalSwitchTitle"
                android:textColor="@color/SeekBackgroundFilled"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:thumbTint="@color/SeekBackgroundFilled"
                app:trackDecorationTint="@color/SeekBackgroundFilled"
                app:trackTint="@color/MID" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:alpha="0.75"
                android:paddingBottom="6dp"
                android:text="@string/OptimalSwitchDescription"
                android:textColor="@color/SeekBackgroundFilled"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/Compatibility_MODE"
                app:layout_constraintTop_toBottomOf="@id/Compatibility_MODE" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/Additional_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:background="@drawable/fast_setting_bg"
            android:padding="12dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/FullScreenAPISwitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/FullScreenAPITitle"
                android:textColor="@color/SeekBackgroundFilled"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:thumbTint="@color/SeekBackgroundFilled"
                app:trackDecorationTint="@color/SeekBackgroundFilled"
                app:trackTint="@color/MID" />

            <TextView
                android:id="@+id/FullScreenAPIText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:alpha="0.75"
                android:paddingBottom="6dp"
                android:text="@string/FullScreenAPIDescription"
                android:textColor="@color/SeekBackgroundFilled"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/FullScreenAPISwitch" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/divider10"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="?android:attr/listDivider" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/Additional_6"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:animateLayoutChanges="true"
            android:background="@drawable/fast_setting_bg"
            android:padding="12dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/LockPhoneIfAfk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/LockThePhoneTitle"
                android:textColor="@color/SeekBackgroundFilled"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:thumbTint="@color/SeekBackgroundFilled"
                app:trackDecorationTint="@color/SeekBackgroundFilled"
                app:trackTint="@color/MID" />

            <TextView
                android:id="@+id/LockThePhoneDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:alpha="0.75"
                android:paddingBottom="6dp"
                android:text="@string/LockThePhoneDesc"
                android:textColor="@color/SeekBackgroundFilled"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/LockPhoneIfAfk" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/AFKTimer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:background="@drawable/inline_setting"
                android:padding="12dp"
                app:layout_constraintTop_toBottomOf="@+id/LockThePhoneDesc"
                tools:layout_editor_absoluteX="12dp">

                <TextView
                    android:id="@+id/LockTimerTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/LockTimerTitle"
                    android:textColor="@color/SeekBackgroundFilled"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/LockTimerSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-8dp"
                    android:layout_marginEnd="-8dp"
                    android:contentDescription="@string/LockTimerTitle"
                    android:stepSize="1"
                    android:value="8"
                    android:valueFrom="1"
                    android:valueTo="20"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/LockTimerTitle" />

                <TextView
                    android:id="@+id/LockTimerDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:alpha="0.75"
                    android:text="@string/LockTimerDesc"
                    android:textColor="@color/SeekBackgroundFilled"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/LockTimerSlider" />

            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/divider11"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="?android:attr/listDivider" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/Additional_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:background="@drawable/fast_setting_bg"
            android:padding="12dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/GoogleHelpers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/GoogleCrashlyticsSettingsTitle"
                android:textColor="@color/SeekBackgroundFilled"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:thumbTint="@color/SeekBackgroundFilled"
                app:trackDecorationTint="@color/SeekBackgroundFilled"
                app:trackTint="@color/MID" />

            <TextView
                android:id="@+id/GoogleHelpersText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:alpha="0.75"
                android:paddingBottom="6dp"
                android:text="@string/GoogleCrashlyticsSettingsDesc"
                android:textColor="@color/SeekBackgroundFilled"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/GoogleHelpers" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/Additional_5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:background="@drawable/fast_setting_bg"
            android:padding="12dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/UseGitVerseAPI"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/Settings_ADD_GitVerse"
                android:textColor="@color/SeekBackgroundFilled"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:thumbTint="@color/SeekBackgroundFilled"
                app:trackDecorationTint="@color/SeekBackgroundFilled"
                app:trackTint="@color/MID" />

            <TextView
                android:id="@+id/GitVerseAPIText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.75"
                android:paddingBottom="6dp"
                android:text="@string/Settings_ADD_GitVerseDesc"
                android:textColor="@color/SeekBackgroundFilled"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/UseGitVerseAPI" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</ScrollView>